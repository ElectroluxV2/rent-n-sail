{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist/frontend/browser",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/frontend/**"
    }
  },
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://rent-n-sail-backend.vercel.app/api"
    },
    {
      "source": "/api/:path*",
      "destination": "https://rent-n-sail-backend.vercel.app/api/:path*"
    },
    {
      "source": "/",
      "destination": "/api/index.js"
    },
    {
      "source": "/:path*",
      "destination": "/api/index.js"
    }
  ]
}
