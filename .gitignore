# Shared local configuration
.idea
.vercel
.env*
!/.env.example

# Python bytecode and isolated environments
__pycache__/
.venv/
.pytest_cache/

# Frontend compiled output and dependencies
/frontend/dist
/frontend/tmp
/frontend/out-tsc
/frontend/bazel-out
/frontend/node_modules
/frontend/**/npm-debug.log
/frontend/**/yarn-error.log

# Frontend IDEs and editors
/frontend/**/.project
/frontend/**/.classpath
/frontend/**/.c9/
/frontend/**/*.launch
/frontend/**/.settings/
/frontend/**/*.sublime-workspace

# Frontend Visual Studio Code settings
/frontend/.vscode/*
!/frontend/.vscode/settings.json
!/frontend/.vscode/tasks.json
!/frontend/.vscode/launch.json
!/frontend/.vscode/extensions.json
!/frontend/.vscode/mcp.json
/frontend/.history/*

# Frontend caches and generated files
/frontend/.angular/cache
/frontend/**/.sass-cache/
/frontend/connect.lock
/frontend/coverage
/frontend/libpeerconnection.log
/frontend/**/testem.log
/frontend/typings
/frontend/**/__screenshots__/

# Local CI tooling dependencies
/.github/actions/**/node_modules/

# System files
.DS_Store
Thumbs.db
